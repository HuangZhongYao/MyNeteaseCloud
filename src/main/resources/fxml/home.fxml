<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>

<BorderPane fx:id="root" minHeight="440" minWidth="860" prefHeight="640" prefWidth="1060"
            style="-fx-background-color: #f7f8fa;"
            stylesheets="@../style/top-bar.css"
            xmlns="http://javafx.com/javafx/11.0.14-internal"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.smog.neteasecloud.contrll.HomeController">

    <!-- ==================== 顶部导航栏 ==================== -->
    <top>
        <HBox fx:id="top" alignment="CENTER_LEFT" spacing="4" styleClass="top-bar-container"
              style="-fx-background-color: linear-gradient(to right, #e83a3f, #ec4141); -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 6, 0, 0, 2); -fx-padding: 0 0 0 24;">
            <children>
                <!-- Logo -->
                <HBox fx:id="logo" alignment="CENTER_LEFT" prefHeight="64" prefWidth="170"
                      style="-fx-background-image: url('/image/topbar.png'); -fx-background-repeat: no-repeat; -fx-background-position: 0 6;"/>

                <!-- 发现音乐 -->
                <Hyperlink fx:id="discoverMenu" text="发现音乐"
                           styleClass="tob-nav"
                           onAction="#toDiscover" onMouseEntered="#setTopNavHover" onMouseExited="#removeTopNavHover"/>
                <!-- 关注 -->
                <Hyperlink fx:id="followMenu" text="关注"
                           styleClass="tob-nav"
                           onAction="#toFollow" onMouseEntered="#setTopNavHover" onMouseExited="#removeTopNavHover"/>
                <!-- 商城 -->
                <Hyperlink fx:id="storeMenu" text="商城"
                           styleClass="tob-nav"
                           onAction="#toStore" onMouseEntered="#setTopNavHover" onMouseExited="#removeTopNavHover"/>
                <!-- 音乐人 -->
                <Hyperlink fx:id="musicianMenu" text="音乐人"
                           styleClass="tob-nav"
                           onAction="#toMusician" onMouseEntered="#setTopNavHover" onMouseExited="#removeTopNavHover"/>
                <!-- 云推歌 -->
                <Hyperlink fx:id="cloudPushMenu" text="云推歌"
                           styleClass="tob-nav"
                           onAction="#toCloudPush" onMouseEntered="#setTopNavHover" onMouseExited="#removeTopNavHover"/>

                <!-- 搜索框 -->
                <TextField fx:id="search" promptText="搜索音乐 / 歌手 / 专辑" styleClass="search-field">
                    <padding>
                        <Insets top="6" right="14" bottom="6" left="36"/>
                    </padding>
                    <HBox.margin>
                        <Insets left="16"/>
                    </HBox.margin>
                </TextField>

                <!-- 头像 -->
                <ImageView fitHeight="38" fitWidth="38" pickOnBounds="true" preserveRatio="true"
                           styleClass="avatar-container">
                    <image>
                        <Image url="@../image/tx.jpg"/>
                    </image>
                    <clip>
                        <Rectangle arcHeight="38" arcWidth="38" height="38" width="38"/>
                    </clip>
                    <HBox.margin>
                        <Insets left="32"/>
                    </HBox.margin>
                </ImageView>
            </children>
        </HBox>
    </top>

    <!-- ==================== 左侧菜单栏 ==================== -->
    <left>
        <VBox fx:id="leftMenu" prefWidth="220" styleClass="left-menu-container"
              style="-fx-background-color: #f0f2f5; -fx-border-color: #e8e8e8; -fx-border-width: 0 1 0 0; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.03), 4, 0, 1, 0);">
            <children>
                <!-- 推荐 -->
                <Hyperlink fx:id="recommendMenu" text="推荐"
                           styleClass="left-menu"
                           onAction="#toRecommend" onMouseEntered="#setSelectedBackgroundColor" onMouseExited="#removeBackgroundColor">
                    <graphic>
                        <ImageView>
                            <image>
                                <Image preserveRatio="true" requestedHeight="22" requestedWidth="22" url="@/image/icon/wyy.png"/>
                            </image>
                        </ImageView>
                    </graphic>
                </Hyperlink>
                <!-- 精选 -->
                <Hyperlink fx:id="featuredMenu" text="精选"
                           styleClass="left-menu"
                           onAction="#toFeatured" onMouseEntered="#setSelectedBackgroundColor" onMouseExited="#removeBackgroundColor">
                    <graphic>
                        <ImageView>
                            <image>
                                <Image preserveRatio="true" requestedHeight="18" requestedWidth="18" url="@/image/icon/yyyjx.png"/>
                            </image>
                        </ImageView>
                    </graphic>
                </Hyperlink>
                <!-- 播客 -->
                <Hyperlink text="播客"
                           styleClass="left-menu"
                           onAction="#toPodcast" onMouseEntered="#setSelectedBackgroundColor" onMouseExited="#removeBackgroundColor">
                    <graphic>
                        <ImageView>
                            <image>
                                <Image preserveRatio="true" requestedHeight="18" requestedWidth="18" url="@/image/icon/bk.png"/>
                            </image>
                        </ImageView>
                    </graphic>
                </Hyperlink>
                <!-- 私人漫游 -->
                <Hyperlink text="私人漫游"
                           styleClass="left-menu"
                           onAction="#toPrivateRoaming" onMouseEntered="#setSelectedBackgroundColor" onMouseExited="#removeBackgroundColor">
                    <graphic>
                        <ImageView>
                            <image>
                                <Image preserveRatio="true" requestedHeight="18" requestedWidth="18" url="@/image/icon/srmy.png"/>
                            </image>
                        </ImageView>
                    </graphic>
                </Hyperlink>
                <!-- 社区 -->
                <Hyperlink text="社区"
                           styleClass="left-menu"
                           onAction="#toCommunity" onMouseEntered="#setSelectedBackgroundColor" onMouseExited="#removeBackgroundColor">
                    <graphic>
                        <ImageView>
                            <image>
                                <Image preserveRatio="true" requestedHeight="18" requestedWidth="18" url="@/image/icon/sq.png"/>
                            </image>
                        </ImageView>
                    </graphic>
                </Hyperlink>
                <!-- 我喜欢的音乐 -->
                <Hyperlink text="我喜欢的音乐"
                           styleClass="left-menu"
                           onAction="#toILike" onMouseEntered="#setSelectedBackgroundColor" onMouseExited="#removeBackgroundColor">
                    <graphic>
                        <ImageView>
                            <image>
                                <Image preserveRatio="true" requestedHeight="18" requestedWidth="18" url="@/image/icon/like.png"/>
                            </image>
                        </ImageView>
                    </graphic>
                </Hyperlink>
                <!-- 我的播客 -->
                <Hyperlink text="我的播客"
                           styleClass="left-menu"
                           onAction="#toMyPodcast" onMouseEntered="#setSelectedBackgroundColor" onMouseExited="#removeBackgroundColor">
                    <graphic>
                        <ImageView>
                            <image>
                                <Image requestedHeight="18" requestedWidth="18" url="@/image/icon/wdbk.png"/>
                            </image>
                        </ImageView>
                    </graphic>
                </Hyperlink>
                <!-- 我的收藏 -->
                <Hyperlink text="我的收藏"
                           styleClass="left-menu"
                           onAction="#toMyCollection" onMouseEntered="#setSelectedBackgroundColor" onMouseExited="#removeBackgroundColor">
                    <graphic>
                        <ImageView>
                            <image>
                                <Image requestedHeight="18" requestedWidth="18" url="@/image/icon/sc.png"/>
                            </image>
                        </ImageView>
                    </graphic>
                </Hyperlink>
                <!-- 下载管理 -->
                <Hyperlink text="下载管理"
                           styleClass="left-menu"
                           onAction="#toDownloadManagement" onMouseEntered="#setSelectedBackgroundColor" onMouseExited="#removeBackgroundColor">
                    <graphic>
                        <ImageView>
                            <image>
                                <Image requestedHeight="18" requestedWidth="18" url="@/image/icon/xz.png"/>
                            </image>
                        </ImageView>
                    </graphic>
                </Hyperlink>
            </children>
            <padding>
                <Insets top="16"/>
            </padding>
        </VBox>
    </left>

    <!-- ==================== 中央内容区 ==================== -->
    <center>
        <Pane fx:id="centerPane" style="-fx-background-color: #f7f8fa;"/>
    </center>

    <!-- ==================== 底部播放器 ==================== -->
    <bottom>
        <VBox spacing="6" styleClass="player-bar">
            <children>
                <!-- 当前歌曲名 -->
                <Label fx:id="currentSongNameLabel" styleClass="song-name-label" text="暂无歌曲"/>

                <!-- 进度条 -->
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <children>
                        <Label fx:id="currentTimeLabel" styleClass="time-label" text="00:00"/>
                        <Slider fx:id="progressSlider" styleClass="progress-slider" HBox.hgrow="ALWAYS" prefWidth="500"
                                onMousePressed="#onProgressPressed" onMouseReleased="#onProgressReleased"/>
                        <Label fx:id="totalTimeLabel" styleClass="time-label" text="00:00"/>
                    </children>
                </HBox>

                <!-- 控制按钮行 -->
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <children>
                        <Button fx:id="previousButton" text="上一首" styleClass="player-btn-secondary"
                                mnemonicParsing="false" onAction="#playPreviousSong"/>
                        <Button fx:id="playPauseButton" text="播放" styleClass="player-btn-primary"
                                mnemonicParsing="false" onAction="#togglePlayPause"/>
                        <Button fx:id="nextButton" text="下一首" styleClass="player-btn-secondary"
                                mnemonicParsing="false" onAction="#playNextSong"/>
                        <Button fx:id="playModeButton" text="列表循环" styleClass="player-btn-ghost"
                                mnemonicParsing="false" onAction="#switchPlayMode"/>
                        <Button text="重新扫描" styleClass="player-btn-ghost"
                                mnemonicParsing="false" onAction="#reloadLocalSongs"/>
                        <Button fx:id="playlistToggleButton" text="播放列表" styleClass="player-btn-ghost"
                                mnemonicParsing="false" onAction="#togglePlaylistDrawer"/>

                        <Label styleClass="info-label" text="音量">
                            <HBox.margin>
                                <Insets left="10"/>
                            </HBox.margin>
                        </Label>
                        <Slider fx:id="volumeSlider" styleClass="volume-slider" prefWidth="100"/>

                        <Pane HBox.hgrow="ALWAYS"/>

                        <Label fx:id="playlistInfoLabel" styleClass="info-label" text="本地歌曲：0"/>
                    </children>
                </HBox>

                <!-- 播放列表抽屉 -->
                <VBox fx:id="playlistDrawer" managed="false" visible="false" translateY="180" spacing="8"
                      styleClass="playlist-drawer">
                    <children>
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #8895a8; -fx-font-weight: bold;"
                               text="🎵 播放列表（双击歌曲可立即播放）"/>
                        <ListView fx:id="songListView" prefHeight="140" style="-fx-background-insets: 0;"
                                  onMouseClicked="#onSongListClicked"/>
                    </children>
                </VBox>
            </children>
        </VBox>
    </bottom>
</BorderPane>
